{
  "name": "pxshot-api",
  "version": "1.0.1",
  "description": "Official JavaScript/TypeScript client for the pxshot screenshot API.",
  "keywords": [
    "pxshot",
    "screenshot",
    "screenshot-api",
    "url-to-image",
    "url-to-pdf",
    "og-image",
    "headless-chrome",
    "api"
  ],
  "homepage": "https://pxshot.dev/docs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/axoxweb/pxshot-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/axoxweb/pxshot-sdk/issues"
  },
  "license": "MIT",
  "author": "Axox Web Solutions <support@pxshot.dev>",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build"
